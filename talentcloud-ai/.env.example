# Copiar a .env (no se versiona). Variables con el prefijo TALENTCLOUD_AI_.
TALENTCLOUD_AI_ENTORNO=local
# Si se define, Laravel debe enviarla en la cabecera X-Api-Key (MATCHING_API_KEY en talentcloud/.env).
TALENTCLOUD_AI_API_KEY=
# sentence-transformers (requiere `uv sync --extra ml`) | determinista (sin modelo: tests o desarrollo sin descargar pesos)
TALENTCLOUD_AI_EMBEDDINGS_BACKEND=sentence-transformers
TALENTCLOUD_AI_LOG_LEVEL=INFO
