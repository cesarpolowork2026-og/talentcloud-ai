APP_NAME="TalentCloud AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# En GCP, detrás del balanceador: TRUSTED_PROXIES=* (o sus rangos de IP)
TRUSTED_PROXIES=
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=talentcloud
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Caché de roles de spatie/laravel-permission. En producción con un solo servidor: file.
PERMISSION_CACHE_STORE=default
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@talentcloud.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Servicio de IA (talentcloud-ai). Deshabilitado: los CV se procesan igual y el matching usa el motor "fake".
IA_HABILITADA=false
IA_URL=http://127.0.0.1:8001
# Misma clave que TALENTCLOUD_AI_API_KEY en talentcloud-ai/.env
IA_API_KEY=
IA_TIMEOUT=30
# Motor de matching: fake (análisis básico) | http (servicio de IA, requiere IA_HABILITADA=true; si el
# servicio falla se usa el análisis básico y `php artisan talentcloud:recalcular-matching --solo-basicos` lo rehace).
MATCHING_ENGINE=fake

# Demora de los avisos de estado al postulante (minutos): un arrastre accidental deshecho a tiempo no se avisa.
AVISOS_DEMORA_MINUTOS=10

# Dashboard: minutos de lectura por CV con los que se calcula el tiempo ahorrado por la IA (el supuesto se muestra en pantalla).
AHORRO_MINUTOS_POR_CV=6

# Segundos que se guardan las cifras agregadas del dashboard por empresa (0 = sin caché).
DASHBOARD_CACHE_SEGUNDOS=60

# Responsable de los datos (política de privacidad y términos). Completar antes de producción.
LEGAL_RESPONSABLE="${APP_NAME}"
# Contacto de privacidad; vacío = el correo de soporte.
LEGAL_CONTACTO=
LEGAL_RUC=
LEGAL_DOMICILIO=

# Correo de soporte: pie de página y destino de las hojas del Libro de Reclamaciones.
SOPORTE_CORREO=talentcloudia@gmail.com

# Cobro de los planes Starter y Pro. Vacío: la empresa solicita el plan y lo aplica el admin SaaS.
# stripe: pago con Stripe Checkout; el plan cambia cuando Stripe lo confirma en /stripe/webhook.
PAGOS_PASARELA=
STRIPE_SECRET=
# Local: el que muestra `stripe listen`; en producción, el del endpoint creado en el panel de Stripe.
STRIPE_WEBHOOK_SECRET=
# Identificadores del panel de Stripe: tasa de IGV (18 %, excluida del precio) y precios en soles sin IGV.
STRIPE_IGV=
STRIPE_PRECIO_STARTER_MENSUAL=
STRIPE_PRECIO_STARTER_ANUAL=
STRIPE_PRECIO_PRO_MENSUAL=
STRIPE_PRECIO_PRO_ANUAL=
