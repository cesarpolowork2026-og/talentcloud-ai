# Configuración de producción. Copiar a ".env" (junto al docker-compose.prod.yml) y completar.
# El archivo .env NO se sube a GitHub.

# — Servidor web —
# Un dominio, o "<ip-con-guiones>.sslip.io" (por ejemplo 203-0-113-10.sslip.io): HTTPS automático.
# ":80" solo para pruebas locales sin certificado.
SITE_ADDRESS=203-0-113-10.sslip.io
# Con HTTPS automático, la URL pública completa (https://...).
APP_URL=https://203-0-113-10.sslip.io

# Puertos publicados (en una prueba local, 8088 y 8443 evitan chocar con otros programas).
PUERTO_HTTP=80
PUERTO_HTTPS=443

# Imágenes (las construye el CI y se descargan del registro; en local se construyen).
IMAGEN_PREFIJO=ghcr.io/cesarpolowork2026-og/talentcloud-ai
IMAGEN_ETIQUETA=latest

# — Aplicación —
APP_NAME="TalentCloud AI"
APP_ENV=production
APP_DEBUG=false
# Generar con: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show
APP_KEY=
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# — Base de datos (la clave debe ser larga y distinta a la de desarrollo) —
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=talentcloud
DB_USERNAME=talentcloud
DB_PASSWORD=

# — Sesión, caché y colas (un solo servidor) —
SESSION_DRIVER=file
CACHE_STORE=file
PERMISSION_CACHE_STORE=default
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
DASHBOARD_CACHE_SEGUNDOS=60

# — Servicio de IA (misma clave en los dos lados) —
IA_HABILITADA=true
IA_URL=http://ia:8080
IA_API_KEY=
IA_TIMEOUT=30
MATCHING_ENGINE=http

# — Correo (ejemplo con Gmail y una contraseña de aplicación) —
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TalentCloud AI"

# — Datos de contacto y legales —
SOPORTE_CORREO=talentcloudia@gmail.com
LEGAL_RESPONSABLE="TalentCloud AI"
LEGAL_CONTACTO=
LEGAL_RUC=
LEGAL_DOMICILIO=

# — Pagos (vacío = la empresa solicita el plan y el admin lo aplica) —
PAGOS_PASARELA=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_IGV=
STRIPE_PRECIO_STARTER_MENSUAL=
STRIPE_PRECIO_STARTER_ANUAL=
STRIPE_PRECIO_PRO_MENSUAL=
STRIPE_PRECIO_PRO_ANUAL=
